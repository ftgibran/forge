{
  "name": "forge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:api": "pnpm --filter @app/api run start:dev",
    "dev:admin": "pnpm --filter @app/admin run dev",
    "dev:client": "pnpm --filter @app/client run dev",
    "build": "./scripts/build.sh",
    "build:api": "pnpm --filter @app/api run build",
    "build:admin": "pnpm --filter @app/admin run build",
    "build:client": "pnpm --filter @app/client run build",
    "test": "pnpm --filter @app/api run test",
    "test:e2e": "pnpm --filter @app/api run test:e2e",
    "lint": "pnpm -r run lint && prettier --write \"**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "eslint --flag unstable_config_lookup_from_file --fix",
      "prettier --write"
    ],
    "apps/admin/**/*.{ts,tsx}": [
      "eslint --flag unstable_config_lookup_from_file --fix",
      "prettier --write"
    ],
    "apps/client/**/*.{ts,tsx}": [
      "eslint --flag unstable_config_lookup_from_file --fix",
      "prettier --write"
    ],
    "packages/utils/**/*.ts": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2"
  }
}
